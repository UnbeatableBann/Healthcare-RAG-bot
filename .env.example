APP_NAME=Healthcare AI Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_MODEL=local-llamacpp-model
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=10
FINAL_CONTEXT_TOP_K=5

VECTORSTORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=healthcare_documents
VECTOR_SIZE=384

DEFAULT_CHUNKING_STRATEGY=hybrid
CHUNK_SIZE=900
CHUNK_OVERLAP=120
SEMANTIC_SIMILARITY_THRESHOLD=0.72

MULTI_QUERY_COUNT=3
DENSE_TOP_K=30
SPARSE_TOP_K=30
HYBRID_TOP_K=30
RRF_K=60

CRAG_LOW_CONFIDENCE_THRESHOLD=0.35
CRAG_HIGH_CONFIDENCE_THRESHOLD=0.70
LLM_JUDGE_ENABLED=true
